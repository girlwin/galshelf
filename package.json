{
  "name": "galshelf",
  "productName": "galshelf",
  "version": "1.3.0",
  "private": true,
  "description": "本地 Galgame 游戏库、分类与启动器",
  "main": "main.js",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "test:smoke": "node scripts/smoke.js",
    "test:capture": "node scripts/capture-smoke.js",
    "build:capture": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-capture.ps1",
    "build": "node build.js",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "@electron/packager": "19.1.1"
  }
}
